{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash"
  },
  "permissions": {
    "deny": [
      "Bash(cargo publish *)",
      "Bash(* cargo publish *)",
      "Bash(npm publish *)",
      "Bash(* npm publish *)",
      "Bash(npm unpublish *)",
      "Bash(* npm unpublish *)",
      "Bash(npm deprecate *)",
      "Bash(* npm deprecate *)",
      "Bash(cargo yank *)",
      "Bash(* cargo yank *)",
      "Bash(cargo owner *)",
      "Bash(* cargo owner *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-shell.py"
          }
        ]
      }
    ]
  }
}
